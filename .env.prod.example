# Project
COMPOSE_PROJECT_NAME=remesas_app
APP_NAME="Sistema de Remesas"
APP_VERSION=1.0.0

# Database (shared MariaDB)
DB_HOST=page_app_prod_db
DB_PORT=3306
DB_DATABASE=remesas
DB_USERNAME=root
DB_PASSWORD=rootDocker2026

# App
APP_ENV=production
APP_DEBUG=false
APP_URL=https://remesas.jlssystem.com
APP_TIMEZONE=America/Bogota
APP_LOCALE=es

# Cloudinary (para almacenar imágenes de recibos)
FILESYSTEM_DISK=cloudinary
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret
CLOUDINARY_FOLDER=receipts

# Ports (no conflict with jlssystem.com on 8080/9443)
HTTP_PORT=8082
HTTPS_PORT=9444
