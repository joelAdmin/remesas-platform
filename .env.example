# Project
COMPOSE_PROJECT_NAME=remesas
APP_NAME="Sistema de Remesas"
APP_VERSION=1.0.0

# Database
DB_HOST=db
DB_PORT=3306
DB_DATABASE=remesas
DB_USERNAME=root
DB_PASSWORD=secret_password

# phpMyAdmin (local only)
PHPMA_PORT=8081

# App
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Bogota
APP_LOCALE=es

# Ports
HTTP_PORT=8080
