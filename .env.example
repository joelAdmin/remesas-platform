# Project
COMPOSE_PROJECT_NAME=remesas
APP_NAME="Sistema de Remesas"
APP_VERSION=1.0.0

# Database
DB_HOST=db
DB_PORT=3308
DB_DATABASE=remesas_db
DB_USERNAME=remesas_user
DB_PASSWORD=secret_password

# phpMyAdmin
PHPMA_PORT=8082

# Webserver
WEBSERVER_NAME=remesas_nginx

# App
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Caracas
APP_LOCALE=es

# Ports
HTTP_PORT=8080
HTTPS_PORT=9443
